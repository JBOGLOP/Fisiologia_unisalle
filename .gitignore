# Guías docentes: contienen el banco de preguntas CON respuestas
guia-docente.docx
**/guia-docente.docx

# Código del portal de actividades.
# Contenido.gs incluye las respuestas correctas del quiz calificable.
app/

# BACKEND DE INSTRUMENTOS DE EVALUACIÓN — nunca al repositorio público.
# Los .gs contienen la CLAVE DE RESPUESTAS y los tokens. Publicar uno obliga a
# rehacer el banco completo: retirarlo de la rama no basta, queda en el historial.
*.gs
appsscript.json
tablero*.html
dashboard*.html
taller-*-backend/

# DATOS PERSONALES DE ESTUDIANTES — nunca al repositorio público.
# La lista de curso y la página de asistencia contienen nombres y códigos
# de estudiantes identificables. El repositorio es público: no pueden entrar.
00-asistencia/
*.xlsx
*.csv

# Figuras escaneadas de los textos. Son material protegido de las editoriales:
# publicarlas contradice el propio aviso legal del sitio, que declara que no se
# redistribuye ningún fragmento de los textos con derechos de autor.
# Sirven para proyectar en clase; no para el repositorio público.
*/img/

# Bibliografía y documentos institucionales
*.pdf
Libros/

# Accesos directos de Google Drive
*.gsheet
*.gdoc
*.gslides
*.gform

# Sistema
Thumbs.db
desktop.ini
.DS_Store
~$*
